// STM32H5 (Cortex-M33) smoke model for the build-only firmware (TC-57, TC-63).
// Sized for STM32H563ZI; STM32H503CB uses the lower part. BKPSRAM receives the
// initialized .bkpsram data of h503bkp. RAM stubs for FLASH and RCC registers.
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic
uart: UART.SemihostingUart @ cpu
nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0
    priorityMask: 0xF0
    systickFrequency: 32000000
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x200000
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0xA0000
flash_ctrl: Memory.MappedMemory @ sysbus 0x40022000
    size: 0x400
bkpsram: Memory.MappedMemory @ sysbus 0x40036400
    size: 0x800
rcc: Memory.MappedMemory @ sysbus 0x44020C00
    size: 0x400
